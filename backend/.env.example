DATABASE_URL=postgresql://user:pass@localhost:5432/budget
PORT=9090
APP_BASE_URL=http://127.0.0.1:9090

# Optional: encrypt OAuth tokens at rest (recommended in production)
INTEGRATION_TOKEN_SECRET=change-me-to-a-long-random-string
INTEGRATION_STATE_SECRET=another-long-random-string

# Xero OAuth app (https://developer.xero.com/)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Intuit QuickBooks OAuth app (https://developer.intuit.com/)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox or production
QBO_ENVIRONMENT=sandbox

# OpenAI — natural-language Q&A (POST /api/ask)
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
